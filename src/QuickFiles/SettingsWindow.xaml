<Window x:Class="QuickFiles.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuickFiles Settings"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <StackPanel Margin="20">
        <TextBlock Text="Number of files to show" FontWeight="SemiBold" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <Slider x:Name="MaxItemsSlider" Minimum="5" Maximum="50" TickFrequency="5"
                    IsSnapToTickEnabled="True" TickPlacement="BottomRight" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ElementName=MaxItemsSlider, Path=Value, StringFormat={}{0:0}}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" />
        </Grid>

        <TextBlock Text="Sort order" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ComboBox x:Name="SortCombo" Margin="0,0,0,16">
            <ComboBoxItem Content="Newest first" />
            <ComboBoxItem Content="Oldest first" />
            <ComboBoxItem Content="Name (A–Z)" />
        </ComboBox>

        <TextBlock Text="Sources" FontWeight="SemiBold" Margin="0,0,0,6" />
        <CheckBox x:Name="IncludeDownloadsCheck" Content="Downloaded files (Downloads folder)" Margin="0,0,0,4" />
        <CheckBox x:Name="IncludeRecentCheck" Content="Recently opened files (Windows recent items)" Margin="0,0,0,16" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Cancel" Width="80" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Save" Width="80" FontWeight="SemiBold" Click="Save_Click" />
        </StackPanel>

        <Separator Margin="0,18,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock x:Name="VersionText" Foreground="#6B7280" FontSize="11" />
                <TextBlock x:Name="UpdateStatusText" Foreground="#6B7280" FontSize="11"
                           TextWrapping="Wrap" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Check for updates" Padding="8,2" Margin="0,0,8,0" Click="CheckUpdates_Click" />
                <Button Content="Quit app" Padding="8,2" Click="Quit_Click"
                        ToolTip="Fully exit QuickFiles (it relaunches next time you click the taskbar icon)" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
